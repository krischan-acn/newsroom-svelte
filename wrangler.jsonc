// Cloudflare Workers configuration.
//
// Deliberately minimal: one Worker plus its static assets. No R2, KV, D1 or
// Durable Objects - SvelteKit has no ISR, so there is no page store to host.
// Page caching happens at the edge through the Cache API (src/hooks.server.ts).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "acn-newsroom-svelte",
	// The adapter WRITES its generated worker to this path on every build, so a
	// hand-written entry cannot live here (tried 2026-11-03; see
	// docs/evaluation-2026-10-23.md, "Fix 1").
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	}
}
